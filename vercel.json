{
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/admin-panel",
      "destination": "/admin-panel/index.html"
    },
    {
      "source": "/admin-panel/",
      "destination": "/admin-panel/index.html"
    },
    {
      "source": "/:path((?!admin-panel).*)",
      "destination": "/index.html"
    }
  ]
}
